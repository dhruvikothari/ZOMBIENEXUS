{
  "name": "zombienexus",
  "version": "1.0.0",
  "description": "ZOMBIENEXUS: CryptoZombies midterm project with Avenger battles, Ganache chain and a React front end",
  "private": true,
  "license": "MIT",
  "main": "truffle-config.js",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "setup": "npm ci && npm run compile",
    "compile": "node scripts/run.js truffle compile",
    "chain": "node scripts/chain.js",
    "migrate": "node scripts/run.js truffle migrate --reset --network development",
    "seed": "node scripts/seed.js",
    "export": "node scripts/export.js",
    "check": "node scripts/check.js",
    "serve": "node scripts/serve.js",
    "demo": "node scripts/demo.js",
    "reset": "node scripts/state.js reset",
    "snapshot": "node scripts/state.js snapshot",
    "restore": "node scripts/state.js restore",
    "doctor": "node scripts/doctor.js",
    "test": "node scripts/test.js",
    "test:ui": "node scripts/run.js vitest run --config frontend/vitest.config.ts",
    "build": "node scripts/run.js tsc --noEmit -p frontend/tsconfig.json && node scripts/run.js vite build --config frontend/vite.config.ts",
    "dev": "node scripts/run.js vite --config frontend/vite.config.ts",
    "changes": "node scripts/changes.js"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "ethers": "6.17.0",
    "lucide-react": "1.57.0",
    "motion": "14.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "ganache": "7.9.2",
    "jsdom": "30.1.3",
    "solc": "0.4.25",
    "tailwindcss": "4.3.3",
    "truffle": "5.11.5",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
